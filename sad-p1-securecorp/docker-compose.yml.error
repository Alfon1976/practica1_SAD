name: sad-p1

services:

  servidor:
    build: .
    image: sad-p1-securecorp
    container_name: sad-p1-servidor
    hostname: servidor
    command: ["/usr/local/bin/arranque-servidor.sh"]
    volumes:
      - ./pki:/pki
      - ./ldif:/ldif
      - ./krb5/krb5.conf:/etc/krb5.conf:ro
      - ./krb5/kdc.conf:/etc/krb5kdc/kdc.conf:ro
    networks:
      securecorp:
        aliases:
          - ldap.securecorp.local
          - kdc.securecorp.local
    tty: true
    stdin_open: true

  cliente:
    image: sad-p1-securecorp
    container_name: sad-p1-cliente
    hostname: cliente
    volumes:
      - ./pki:/pki
      - ./ldif:/ldif
      - ./krb5/krb5.conf:/etc/krb5.conf:ro
    networks:
      - securecorp
    depends_on:
      - servidor
    tty: true
    stdin_open: true

  phpldapadmin:
    image: osixia/phpldapadmin:0.9.0
    container_name: sad-p1-phpldapadmin
    environment:
      PHPLDAPADMIN_LDAP_HOSTS: ldap.securecorp.local
      PHPLDAPADMIN_HTTPS: "false"
    ports:
      - "8081:80"
    networks:
      - securecorp
    depends_on:
      - servidor

  # ✍️ Parte C: aquí va el servicio web
    web:
    build: web
    container_name: sad-p1-web
    hostname: web
    volumes:
      - ./pki:/pki:ro
      - ./krb5/krb5.conf:/etc/krb5.conf:ro
    networks:
      securecorp:
        aliases:
          - web.securecorp.local
    depends_on:
      - servidor

networks:
  securecorp:
    driver: bridge
